{
  "source_commit": "fe570a7e5",
  "category": "Mauville and Route 110 dialogue: Route110_TrickHousePuzzle5",
  "texts": [
    {
      "name": "Chs_Route110_TrickHousePuzzle5_Text_CorrectGoThrough",
      "source_symbol": "Route110_TrickHousePuzzle5_Text_CorrectGoThrough",
      "text": "恭喜你，答对啦——！\n请往前走！"
    },
    {
      "name": "Chs_Route110_TrickHousePuzzle5_Text_DisappointmentError",
      "source_symbol": "Route110_TrickHousePuzzle5_Text_DisappointmentError",
      "text": "很遗憾！\n答——错——啦！"
    },
    {
      "name": "Chs_Route110_TrickHousePuzzle5_Text_Mechadoll1Intro",
      "source_symbol": "Route110_TrickHousePuzzle5_Text_Mechadoll1Intro",
      "text": "咔嗒咔嗒⋯⋯\n吾辈是机械娃娃1号！\\p只要连续答对问题，\n一直来到机械娃娃5号那里，\\l就能找到暗号！"
    },
    {
      "name": "Chs_Route110_TrickHousePuzzle5_Text_Mechadoll1Quiz1",
      "source_symbol": "Route110_TrickHousePuzzle5_Text_Mechadoll1Quiz1",
      "text": "机械娃娃1号问答！\\p下列宝可梦中哪一个不能\n在110号道路找到？"
    },
    {
      "name": "Chs_Route110_TrickHousePuzzle5_Text_Mechadoll1Quiz2",
      "source_symbol": "Route110_TrickHousePuzzle5_Text_Mechadoll1Quiz2",
      "text": "机械娃娃1号问答！\\p下列宝可梦中哪一个不是\n水属性？"
    },
    {
      "name": "Chs_Route110_TrickHousePuzzle5_Text_Mechadoll1Quiz3",
      "source_symbol": "Route110_TrickHousePuzzle5_Text_Mechadoll1Quiz3",
      "text": "机械娃娃1号问答！\\p下列宝可梦中哪一个不能\n使用吸血？"
    },
    {
      "name": "Chs_Route110_TrickHousePuzzle5_Text_Mechadoll2Intro",
      "source_symbol": "Route110_TrickHousePuzzle5_Text_Mechadoll2Intro",
      "text": "咔嗒咔嗒⋯⋯\n吾辈是机械娃娃2号！\\l1号的问题也太简单了！"
    },
    {
      "name": "Chs_Route110_TrickHousePuzzle5_Text_Mechadoll2Quiz1",
      "source_symbol": "Route110_TrickHousePuzzle5_Text_Mechadoll2Quiz1",
      "text": "机械娃娃2号问答！\\p满充从你的父亲那里\n借来的是哪只宝可梦？"
    },
    {
      "name": "Chs_Route110_TrickHousePuzzle5_Text_Mechadoll2Quiz2",
      "source_symbol": "Route110_TrickHousePuzzle5_Text_Mechadoll2Quiz2",
      "text": "机械娃娃2号问答！\\p追逐小田卷博士的\n是哪只宝可梦？"
    },
    {
      "name": "Chs_Route110_TrickHousePuzzle5_Text_Mechadoll2Quiz3",
      "source_symbol": "Route110_TrickHousePuzzle5_Text_Mechadoll2Quiz3",
      "text": "机械娃娃2号问答！\\p在橙华森林里，海洋队\n派出的是哪只宝可梦？"
    },
    {
      "name": "Chs_Route110_TrickHousePuzzle5_Text_Mechadoll3Intro",
      "source_symbol": "Route110_TrickHousePuzzle5_Text_Mechadoll3Intro",
      "text": "咔嗒咔嗒⋯⋯\n吾辈是机械娃娃3号！\\l对钱的事，吾辈可很较真！"
    },
    {
      "name": "Chs_Route110_TrickHousePuzzle5_Text_Mechadoll3Quiz1",
      "source_symbol": "Route110_TrickHousePuzzle5_Text_Mechadoll3Quiz1",
      "text": "机械娃娃3号问答！\\p买3封港口邮件，\n和买1份灼伤药，\\l哪样更贵？"
    },
    {
      "name": "Chs_Route110_TrickHousePuzzle5_Text_Mechadoll3Quiz2",
      "source_symbol": "Route110_TrickHousePuzzle5_Text_Mechadoll3Quiz2",
      "text": "机械娃娃3号问答！\\p卖出1个超级球并买入\n1个伤药，还剩多少钱？"
    },
    {
      "name": "Chs_Route110_TrickHousePuzzle5_Text_Mechadoll3Quiz3",
      "source_symbol": "Route110_TrickHousePuzzle5_Text_Mechadoll3Quiz3",
      "text": "机械娃娃3号问答！\\p买1个除虫喷雾和1个劲爽汽水\n花的钱比1个厉害伤药多吗？"
    },
    {
      "name": "Chs_Route110_TrickHousePuzzle5_Text_Mechadoll4Intro",
      "source_symbol": "Route110_TrickHousePuzzle5_Text_Mechadoll4Intro",
      "text": "咔嗒咔嗒⋯⋯\n我是机械娃娃4号哟——！\\l美丽的我要出题啦！"
    },
    {
      "name": "Chs_Route110_TrickHousePuzzle5_Text_Mechadoll4Quiz1",
      "source_symbol": "Route110_TrickHousePuzzle5_Text_Mechadoll4Quiz1",
      "text": "机械娃娃4号问答哟！\\p大海之家里，\n男人多还是女人多？"
    },
    {
      "name": "Chs_Route110_TrickHousePuzzle5_Text_Mechadoll4Quiz2",
      "source_symbol": "Route110_TrickHousePuzzle5_Text_Mechadoll4Quiz2",
      "text": "机械娃娃4号问答哟！\\p釜炎镇里，\n老爷爷多还是老奶奶多？"
    },
    {
      "name": "Chs_Route110_TrickHousePuzzle5_Text_Mechadoll4Quiz3",
      "source_symbol": "Route110_TrickHousePuzzle5_Text_Mechadoll4Quiz3",
      "text": "机械娃娃4号问答哟！\\p宝可梦训练家学校里，\n有多少名女学生？"
    },
    {
      "name": "Chs_Route110_TrickHousePuzzle5_Text_Mechadoll5Intro",
      "source_symbol": "Route110_TrickHousePuzzle5_Text_Mechadoll5Intro",
      "text": "咔嗒咔嗒⋯⋯\n吾辈是机械娃娃5号！\\l大王的最高杰作！"
    },
    {
      "name": "Chs_Route110_TrickHousePuzzle5_Text_Mechadoll5Quiz1",
      "source_symbol": "Route110_TrickHousePuzzle5_Text_Mechadoll5Quiz1",
      "text": "机械娃娃5号问答！\\p在凯那市的宝可梦发烧友俱乐部里，\n一共有多少只宝可梦？"
    },
    {
      "name": "Chs_Route110_TrickHousePuzzle5_Text_Mechadoll5Quiz2",
      "source_symbol": "Route110_TrickHousePuzzle5_Text_Mechadoll5Quiz2",
      "text": "机械娃娃5号问答！\\p茵郁市里一共有\n多少间树屋？"
    },
    {
      "name": "Chs_Route110_TrickHousePuzzle5_Text_Mechadoll5Quiz3",
      "source_symbol": "Route110_TrickHousePuzzle5_Text_Mechadoll5Quiz3",
      "text": "机械娃娃5号问答！\\p在自行车道上\n一共有多少名铁人三项选手？"
    },
    {
      "name": "Chs_Route110_TrickHousePuzzle5_Text_Wahahahaha",
      "source_symbol": "Route110_TrickHousePuzzle5_Text_Wahahahaha",
      "text": "哇哈哈哈哈！哇哈哈哈哈！咔嗒咔嗒！"
    },
    {
      "name": "Chs_Route110_TrickHousePuzzle5_Text_WaitForNextChallenge",
      "source_symbol": "Route110_TrickHousePuzzle5_Text_WaitForNextChallenge",
      "text": "恭候再次挑战——！"
    },
    {
      "name": "Chs_Route110_TrickHousePuzzle5_Text_WroteSecretCodeLockOpened",
      "source_symbol": "Route110_TrickHousePuzzle5_Text_WroteSecretCodeLockOpened",
      "text": "{JPN}{PLAYER}{ENG}把暗号\n写在了门上！\\p“戏法大王大人是天才”\\p⋯⋯　⋯⋯　⋯⋯\\p听到了开锁的声音！"
    }
  ],
